int buttonPin = 7;
int led1 = 10;
int led2 = 13;

int estado = 0;
int ultimo = LOW;

void setup() {
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
  pinMode(buttonPin, INPUT);
  digitalWrite(led1, LOW);
  digitalWrite(led2, LOW);
}

void loop() {
  
  int estadob = digitalRead(buttonPin);
  if (estadob == HIGH && ultimo == LOW) {
    estado++;

    if (estado > 3) {
      estado = 0;}

    if (estado == 0){

      digitalWrite(led1, LOW);
      digitalWrite(led2, LOW);}
    
    
      else if (estado == 1) {
      digitalWrite(led1, HIGH);
      digitalWrite(led2, LOW);

    } else if (estado == 2) {
      digitalWrite(led1, LOW);
      digitalWrite(led2, HIGH);

    } else if (estado == 3){
      digitalWrite(led1, LOW);
      digitalWrite(led2, LOW);
    }

    delay(500);
  }

  ultimo = estadob;
}
